rules_version = '2';

// =====================================================================
// REGRAS DE SEGURANÇA - CELEBRE
// Objetivo: garantir no SERVIDOR (não só na tela) que:
//  1) só usuários logados acessam dados
//  2) cada empresa (tenant) só enxerga os próprios dados
//  3) o e-mail de super admin continua tendo acesso total
//
// ⚠️ PRÉ-REQUISITO PARA ESSAS REGRAS FUNCIONAREM:
// Os documentos da coleção "equipe" precisam ter o ID do documento
// IGUAL ao UID do usuário no Firebase Auth (hoje, pelo código do
// Dashboard, a busca é feita por "where email == ..."; regras de
// segurança não conseguem fazer esse tipo de busca por campo dentro
// de uma verificação de outra coleção, só por ID direto).
//
// Ou seja: ao criar um novo funcionário, em vez de:
//   addDoc(collection(db, "equipe"), { email, empresaId, ... })
// usar:
//   setDoc(doc(db, "equipe", uidDoNovoFuncionario), { email, empresaId, ... })
//
// Documentos de "equipe" já existentes com ID automático continuam
// funcionando para leitura via query por e-mail (regra de "list"
// abaixo cobre isso), mas não seriam reconhecidos nas checagens de
// tenant em "estoque"/"locacoes" até serem migrados para esse padrão.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    // Mesmo e-mail hardcoded do front, mas verificado aqui no servidor
    // via token de autenticação (não pode ser falsificado pelo cliente).
    function isSuperAdmin() {
      return logado() && request.auth.token.email == 'celebrefesta25@gmail.com';
    }

    // O usuário é dono da empresa (o próprio tenant) OU é um funcionário
    // vinculado a ela via coleção "equipe" (doc ID = uid do funcionário).
    function souDonoOuFuncionario(tenantId) {
      return logado() && (
        request.auth.uid == tenantId ||
        (
          exists(/databases/$(database)/documents/equipe/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/equipe/$(request.auth.uid)).data.empresaId == tenantId
        )
      );
    }

    // ---------------------------------------------------------------
    // usuarios/{tenantId}  → dados da empresa/assinatura
    // ---------------------------------------------------------------
    match /usuarios/{tenantId} {
      allow read: if isSuperAdmin() || souDonoOuFuncionario(tenantId);
      // Só o dono (ou super admin) altera dados da própria empresa/assinatura
      allow write: if isSuperAdmin() || (logado() && request.auth.uid == tenantId);
    }

    // ---------------------------------------------------------------
    // equipe/{uid}  → vínculo funcionário -> empresa
    // ---------------------------------------------------------------
    match /equipe/{uid} {
      // Cobre tanto o get direto quanto a query "where email == ..." do Dashboard
      allow read: if isSuperAdmin()
                  || (logado() && resource.data.email == request.auth.token.email)
                  || (logado() && resource.data.empresaId == request.auth.uid)
                  || souDonoOuFuncionario(resource.data.empresaId);

      // Só o dono da empresa (ou super admin) cadastra/edita/remove funcionários,
      // e só dentro da própria empresa.
      allow create: if isSuperAdmin() || (logado() && request.auth.uid == request.resource.data.empresaId);
      allow update, delete: if isSuperAdmin() || (logado() && request.auth.uid == resource.data.empresaId);
    }

    // ---------------------------------------------------------------
    // estoque/{docId}  → peças/itens do acervo (campo userId = tenantId)
    // ---------------------------------------------------------------
    match /estoque/{docId} {
      allow read: if souDonoOuFuncionario(resource.data.userId) || isSuperAdmin();
      allow create: if souDonoOuFuncionario(request.resource.data.userId) || isSuperAdmin();
      allow update, delete: if souDonoOuFuncionario(resource.data.userId) || isSuperAdmin();
    }

    // ---------------------------------------------------------------
    // locacoes/{docId}  → orçamentos/locações (campo userId = tenantId)
    // ---------------------------------------------------------------
    match /locacoes/{docId} {
      allow read: if souDonoOuFuncionario(resource.data.userId) || isSuperAdmin();
      allow create: if souDonoOuFuncionario(request.resource.data.userId) || isSuperAdmin() || request.resource.data.origem == 'catalogo_publico';
      allow update, delete: if souDonoOuFuncionario(resource.data.userId) || isSuperAdmin();
    }

    // ---------------------------------------------------------------
    // configuracoes_empresa/{tenantId}  → configurações da empresa
    // ---------------------------------------------------------------
    match /configuracoes_empresa/{tenantId} {
      allow read: if isSuperAdmin() || souDonoOuFuncionario(tenantId);
      allow write: if isSuperAdmin() || (logado() && request.auth.uid == tenantId);
    }

    // ---------------------------------------------------------------
    // logs_atividades/{docId}  → auditoria de ações
    // ---------------------------------------------------------------
    match /logs_atividades/{docId} {
      allow create: if logado();
      allow read: if isSuperAdmin() 
                  || (logado() && resource.data.empresaId == request.auth.uid) 
                  || (logado() && resource.data.userId == request.auth.uid) 
                  || souDonoOuFuncionario(resource.data.empresaId) 
                  || souDonoOuFuncionario(resource.data.userId);
    }

    // ---------------------------------------------------------------
    // planos/{docId}  → detalhes dos planos de assinatura
    // ---------------------------------------------------------------
    match /planos/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ---------------------------------------------------------------
    // clientes/{docId}  → cadastro de clientes
    // ---------------------------------------------------------------
    match /clientes/{docId} {
      allow read: if isSuperAdmin() || souDonoOuFuncionario(resource.data.userId);
      allow create: if isSuperAdmin() || (logado() && request.resource.data.userId == request.auth.uid) || request.resource.data.origem == 'Auto-Cadastro (Site)';
      allow update, delete: if isSuperAdmin() || souDonoOuFuncionario(resource.data.userId);
    }

    // ---------------------------------------------------------------
    // financeiro_lancamentos/{docId}
    // ---------------------------------------------------------------
    match /financeiro_lancamentos/{docId} {
      allow read: if isSuperAdmin() || souDonoOuFuncionario(resource.data.userId);
      allow create: if isSuperAdmin() || souDonoOuFuncionario(request.resource.data.userId);
      allow update, delete: if isSuperAdmin() || souDonoOuFuncionario(resource.data.userId);
    }

    // ---------------------------------------------------------------
    // lista_compras/{docId}
    // ---------------------------------------------------------------
    match /lista_compras/{docId} {
      allow read: if isSuperAdmin() || souDonoOuFuncionario(resource.data.userId);
      allow create: if isSuperAdmin() || souDonoOuFuncionario(request.resource.data.userId);
      allow update, delete: if isSuperAdmin() || souDonoOuFuncionario(resource.data.userId);
    }

    // ---------------------------------------------------------------
    // clinicas_aso/{docId}
    // ---------------------------------------------------------------
    match /clinicas_aso/{docId} {
      allow read: if isSuperAdmin() || souDonoOuFuncionario(resource.data.empresaId);
      allow create: if isSuperAdmin() || souDonoOuFuncionario(request.resource.data.empresaId);
      allow update, delete: if isSuperAdmin() || souDonoOuFuncionario(resource.data.empresaId);
    }

    // ---------------------------------------------------------------
    // projetos_moodboard/{docId}
    // ---------------------------------------------------------------
    match /projetos_moodboard/{docId} {
      allow read: if isSuperAdmin() || souDonoOuFuncionario(resource.data.userId);
      allow create: if isSuperAdmin() || souDonoOuFuncionario(request.resource.data.userId);
      allow update, delete: if isSuperAdmin() || souDonoOuFuncionario(resource.data.userId);
    }

    // ---------------------------------------------------------------
    // usuarios_equipe/{docId}
    // ---------------------------------------------------------------
    match /usuarios_equipe/{docId} {
      allow read: if isSuperAdmin() || souDonoOuFuncionario(resource.data.empresaId);
      allow create: if isSuperAdmin() || souDonoOuFuncionario(request.resource.data.empresaId);
      allow update, delete: if isSuperAdmin() || souDonoOuFuncionario(resource.data.empresaId);
    }

    // Qualquer coleção não listada explicitamente acima fica bloqueada
    // por padrão — mais seguro do que esquecer de proteger algo novo.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}